# Azure Document Intelligence
DOC_INTELLIGENCE_ENDPOINT=

# Azure AI Search
SEARCH_ENDPOINT=
SEARCH_INDEX_NARRATIVE=narrative-index
SEARCH_INDEX_TABLE=table-index
SEARCH_INDEX_FIGURE=figure-index
SEARCH_INDEX_CATALOG=fund-catalog-index
SEARCH_INDEX_FACTS=evaluation-facts-index

# Blob ingestion (empty INGEST_API_ENDPOINT retains local source-document mode)
STORAGE_BLOB_ENDPOINT=
UPLOAD_CONTAINER=pdfs
ASSETS_CONTAINER=document-assets
INGEST_API_ENDPOINT=
MAX_UPLOAD_MB=50

# Existing runtime defaults to identity. The customer demo injects keys through Azure settings.
AZURE_AUTH_MODE=identity
# Key mode only: do not commit populated values.
# SEARCH_API_KEY=
# DOC_INTELLIGENCE_API_KEY=
# FOUNDRY_API_KEY=
# STORAGE_CONNECTION_STRING=

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_CHAT_DEPLOYMENT=chat
FOUNDRY_VISION_DEPLOYMENT=chat
FOUNDRY_EVAL_DEPLOYMENT=chat
FOUNDRY_EMBEDDING_DEPLOYMENT=embedding
FOUNDRY_API_VERSION=2024-10-21

# Azure Application Insights (OpenTelemetry)
APPINSIGHTS_CONNECTION_STRING=
