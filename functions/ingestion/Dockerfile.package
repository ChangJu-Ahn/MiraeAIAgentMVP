FROM python:3.12-slim AS build
WORKDIR /build
COPY requirements.txt constraints.txt ./
RUN pip install --no-cache-dir --only-binary=:all: \
    --requirement requirements.txt --constraint constraints.txt \
    --target .python_packages/lib/site-packages
COPY function_app.py host.json .deployment build_function_package.py ./
COPY ingest/ ingest/
COPY config/ config/
RUN python build_function_package.py

FROM scratch
COPY --from=build /build/function.zip /function.zip
